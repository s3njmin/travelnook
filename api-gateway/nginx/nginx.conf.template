map $http_apikey $api_client_name {
    default "";

    "${api_gateway_key}" "client_admin";
}

server {
    listen 80;
    
    location = /favicon.ico {
        log_not_found off;
    }

    location /api/v1/hotel(/.*)?$ {
        proxy_pass_request_body on;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        
        if ($request_method != GET) {
            rewrite ^/api/v1/hotel(/.*)?$ /_api/v1/hotel$1 last;
        }

        proxy_pass ${hotel_service_url_internal}/hotel$1;
    }
    
    location /_api/v1/hotel(/.*)?$ {
        internal;
        auth_request /_validate_apikey;

        proxy_pass_request_body on;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;

        proxy_pass ${hotel_service_url_internal}/hotel$1;
    }
    
    
    location /api/v1/bookings(/.*)?$ {
        proxy_pass_request_body on;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        
        if ($request_method != GET) {
            rewrite ^/api/v1/bookings(/.*)?$ /_api/v1/bookings$1 last;
        }

        proxy_pass ${bookings_service_url_internal}/bookings$1;
    }
    
    location /_api/v1/bookings(/.*)?$ {
        internal;
        auth_request /_validate_apikey;

        proxy_pass_request_body on;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;

        proxy_pass ${bookings_service_url_internal}/bookings$1;
    }


    # API key validation
    location = /_validate_apikey {
        internal;

        if ($http_apikey = "") {
            return 401; # Unauthorised
        }
        if ($api_client_name = "") {
            return 403; # Forbidden
        }

        return 204; # OK (no content)
    }

}