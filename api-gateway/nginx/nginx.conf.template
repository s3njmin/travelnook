map $http_apikey $api_client_name {
    default "";

    "${api_gateway_key}" "client_admin";
}

server {
    listen 80;
    
    location = /favicon.ico {
        log_not_found off;
    }


    location /api/v1/hotels/health {
        proxy_pass ${hotels_service_url_internal}/health;
    }

    location /api/v1/hotels {
        proxy_pass ${hotels_service_url_internal}/hotels;
    }

    location /api/v1/hotels/filter {
        proxy_pass ${hotels_service_url_internal}/hotels/filter;
    }

    location /api/v1/rooms/filter {
        proxy_pass ${hotels_service_url_internal}/rooms/filter;
    }


    location /api/v1/bookings/health {
        proxy_pass ${bookings_service_url_internal}/health;
    }

    location /api/v1/bookings {
        proxy_pass ${bookings_service_url_internal}/bookings;
    }
    
    location /api/v1/users/health {
        proxy_pass http://users:5000/health;
    }

    location /api/v1/get_token {
        proxy_pass ${users_service_url_internal}/get_token;
    }

    location /api/v1/users {
        proxy_pass ${users_service_url_internal}/users;
    }

    location /api/v1/subscriptions {
        proxy_pass ${users_service_url_internal}/subscriptions;
    }

}
